{
  "name": "easyuse-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A source-first React component library with live documentation.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm registry:build && pnpm blog:build && pnpm docs:build && next dev --webpack --port 3010",
    "build": "node scripts/validate-site-url.mjs && pnpm registry:build && pnpm blog:build && pnpm docs:build && next build --webpack",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "registry:build": "node scripts/build-registry.mjs",
    "test": "playwright test",
    "test:install": "node scripts/check-install.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "manifest:build": "node scripts/check-manifest.mjs --write",
    "check:manifest": "node scripts/check-manifest.mjs",
    "blog:build": "node scripts/check-blog.mjs --write",
    "check:blog": "node scripts/check-blog.mjs",
    "check:release": "node scripts/check-blog.mjs --release",
    "test:install:themes": "node scripts/check-theme-install.mjs",
    "registry:snapshot": "node scripts/snapshot-registry.mjs",
    "docs:build": "node scripts/build-docs.mjs --write",
    "check:docs": "node scripts/build-docs.mjs && node scripts/check-docs-snippets.mjs",
    "ui-contracts:build": "node scripts/check-ui-contracts.mjs --write",
    "check:ui-contracts": "node scripts/check-ui-contracts.mjs",
    "svg:assets": "node scripts/build-svg-assets.mjs",
    "test:svg:model": "node scripts/test-svg-workbench.mjs",
    "svg:tsx": "node scripts/svg-to-tsx.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "saxes": "6.0.0",
    "shiki": "4.5.0",
    "svgo": "4.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.58.2",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "shadcn": "4.21.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.2"
  }
}
