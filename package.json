{
  "name": "easyuse-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A source-first React component library with live documentation.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm registry:build && next dev --webpack --port 3010",
    "build": "pnpm registry:build && next build --webpack",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "registry:build": "node scripts/build-registry.mjs",
    "test": "playwright test",
    "test:install": "node scripts/check-install.mjs",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.5.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "shadcn": "4.21.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.2"
  }
}
