  "path": "components/ui/chip.module.css",
  "code": ".chip {\n  display: inline-flex;\n  flex: 0 0 auto;\n  align-items: center;\n  min-height: var(--control-height);\n  border: 1px solid var(--border);\n  border-radius: var(--pill-radius);\n  background: var(--surface);\n  color: var(--text-secondary);\n  font-size: 13px;\n  line-height: 20px;\n  vertical-align: middle;\n}\n.chip[data-selected=\"true\"] {\n  border-color: var(--primary);\n  background: var(--selection);\n  color: var(--primary);\n}\n.chip[data-disabled=\"true\"] {\n  opacity: 0.5;\n}\n.main,\n.remove {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 4px;\n  min-height: calc(var(--control-height) - 2px);\n  border: 0;\n  background: transparent;\n  color: inherit;\n  font: inherit;\n  cursor: pointer;\n  transition: background var(--motion-button) ease-out;\n}\n.main,\n.label {\n  padding: 4px 12px;\n  border-radius: var(--pill-radius);\n}\n.remove {\n  width: var(--control-height);\n  height: calc(var(--control-height) - 2px);\n  border-radius: var(--pill-radius);\n}\n.main + .remove {\n  border-left: 1px solid var(--border);\n}\n.main:not(:disabled):hover,\n.remove:not(:disabled):hover {\n  background: var(--surface-hover);\n}\n.main:not(:disabled):active,\n.remove:not(:disabled):active {\n  background: var(--surface-pressed);\n}\n.main:focus-visible,\n.remove:focus-visible {\n  outline: 2px solid var(--ring);\n  outline-offset: 2px;\n}\n.main:disabled,\n.remove:disabled {\n  cursor: default;\n}\n.busyHint {\n  padding-right: 8px;\n  color: var(--text-secondary);\n  font-size: 12px;\n  line-height: 16px;\n}\n@media (pointer: coarse) {\n  .main,\n  .remove {\n    min-width: var(--touch-target);\n    min-height: var(--touch-target);\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .main,\n  .remove {\n    transition: none;\n  }\n}\n",
