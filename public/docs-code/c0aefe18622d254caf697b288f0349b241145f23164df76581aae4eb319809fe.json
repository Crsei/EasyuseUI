  "path": "components/blocks/calendar.module.css",
  "code": ".calendar {\n  min-width: 0;\n  background: var(--surface);\n}\n.hint {\n  font-size: 12px;\n  padding: 8px;\n  color: var(--muted-foreground);\n}\n.weekdays,\n.days {\n  display: grid;\n}\n.weekdays {\n  position: sticky;\n  top: 0;\n  z-index: 2;\n  background: var(--surface-raised);\n  font-size: 12px;\n  text-align: center;\n  border-block: 1px solid var(--border);\n}\n.weekdays span {\n  padding: 8px;\n}\n.day {\n  min-width: 0;\n  min-height: 144px;\n  border-right: 1px solid var(--border);\n  border-bottom: 1px solid var(--border);\n  padding: 4px;\n  overflow: hidden;\n}\n.day[data-adjacent=\"true\"] > .dateButton {\n  color: var(--muted-foreground);\n}\n.day[data-selected=\"true\"] {\n  box-shadow: inset 0 0 0 1px var(--primary);\n  background: var(--selection);\n}\n.dateButton {\n  display: block;\n  min-width: 32px;\n  height: 32px;\n  font-size: 12px;\n  border-radius: 6px;\n  cursor: pointer;\n}\n.dateButton:hover {\n  background: var(--surface-hover);\n}\n.dateButton:focus-visible {\n  outline: 2px solid var(--ring);\n  outline-offset: -2px;\n}\n.day[data-today=\"true\"] .dateButton {\n  font-weight: 600;\n  color: var(--primary);\n  text-decoration: underline;\n  text-underline-offset: 4px;\n}\n.dayEntries {\n  font-size: 12px;\n  min-width: 0;\n}\n.dayEntries :global([data-data-state=\"empty\"]) {\n  display: none;\n}\n.dayEntries :global([data-data-state=\"error\"]) {\n  font-size: 11px;\n}\n.dayEntries :global([data-data-state=\"error\"] > div) {\n  padding: 4px;\n}\n.count {\n  font-size: 10px;\n  color: var(--muted-foreground);\n  padding: 4px;\n}\n.agenda {\n  padding: 12px;\n  border-bottom: 1px solid var(--border);\n}\n.agenda h3 {\n  font-size: 13px;\n  font-weight: 500;\n  margin-bottom: 8px;\n}\n.agenda:focus-visible {\n  outline: 2px solid var(--ring);\n  outline-offset: -2px;\n}\n.weekends {\n  padding: 12px;\n  font-size: 13px;\n}\n.weekends summary {\n  cursor: pointer;\n  min-height: 32px;\n}\n.notice {\n  padding: 4px;\n  color: var(--muted-foreground);\n}\n@media (max-width: 640px) {\n  .day {\n    min-height: 44px;\n    padding: 0;\n  }\n  .dateButton {\n    width: 100%;\n    min-height: 44px;\n  }\n  .dayEntries {\n    display: none;\n  }\n  .weekdays span {\n    padding: 8px 0;\n  }\n  .hint {\n    font-size: 11px;\n  }\n  .agenda {\n    padding: 8px;\n  }\n  .weekends summary {\n    min-height: 44px;\n  }\n}\n@media (pointer: coarse) {\n  .dateButton {\n    min-height: 44px;\n    min-width: 44px;\n  }\n  .weekends summary {\n    min-height: 44px;\n  }\n}\n",
