  "path": "components/examples/dialog-demo.tsx",
  "code": "\"use client\"\nimport { useSiteI18n } from \"@/components/site/site-i18n\"\n\nimport { useId, useState } from \"react\"\nimport { Button } from \"@/components/ui/button\"\nimport { Input } from \"@/components/ui/input\"\nimport {\n  Dialog,\n  DialogClose,\n  DialogContent,\n  DialogDescription,\n  DialogTitle,\n  DialogTrigger,\n} from \"@/components/ui/dialog\"\n\nexport function DialogDemo() {\n  const { t } = useSiteI18n()\n\n  const id = useId()\n  const [name, setName] = useState(\"\")\n  const [created, setCreated] = useState(\"\")\n\n  return (\n    <div className=\"flex flex-col items-center gap-4\">\n      <Dialog>\n        <DialogTrigger render={<Button variant=\"outline\" />}>\n          {t(\"site.createProject\")}\n        </DialogTrigger>\n        <DialogContent>\n          <DialogTitle>{t(\"site.createANewProject\")}</DialogTitle>\n          <DialogDescription>\n            {t(\"site.nameTheProjectThisActionIsOnlyAComponent\")}\n          </DialogDescription>\n          <div className=\"my-6 space-y-2\">\n            <label htmlFor={id} className=\"text-sm font-medium\">\n              {t(\"site.projectName\")}\n            </label>\n            <Input\n              id={id}\n              value={name}\n              onChange={(event) => setName(event.target.value)}\n              placeholder={t(\"site.myNewProject\")}\n            />\n          </div>\n          <div className=\"flex justify-end gap-2\">\n            <DialogClose render={<Button variant=\"ghost\" />}>\n              {t(\"site.cancel\")}\n            </DialogClose>\n            <DialogClose\n              disabled={!name.trim()}\n              render={<Button />}\n              onClick={() => setCreated(name.trim())}\n            >\n              {t(\"site.confirmCreation\")}\n            </DialogClose>\n          </div>\n        </DialogContent>\n      </Dialog>\n      <p role=\"status\" className=\"text-xs text-muted-foreground\">\n        {created\n          ? t(\"site.demoProjectValueCreated\", { value0: created })\n          : t(\"site.supportsKeyboardOperationEscapeAndFocusRestoration\")}\n      </p>\n    </div>\n  )\n}\n",
