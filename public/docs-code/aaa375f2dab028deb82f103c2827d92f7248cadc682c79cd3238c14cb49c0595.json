  "code": ".call {\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  min-width: 0;\n  overflow: hidden;\n}\n.header {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 8px;\n  width: 100%;\n  min-height: 40px;\n  padding: 8px 12px;\n  border: 0;\n  background: transparent;\n  color: inherit;\n  text-align: left;\n  cursor: pointer;\n  font-size: 13px;\n  line-height: 20px;\n}\n.header:hover {\n  background: var(--surface-hover);\n}\n.header:active {\n  background: var(--surface-pressed);\n}\n.header:focus-visible {\n  outline: 2px solid var(--ring);\n  outline-offset: -2px;\n}\n.header > svg {\n  flex-shrink: 0;\n  stroke-width: 1.75;\n}\n.name {\n  font-weight: 500;\n  overflow-wrap: anywhere;\n}\n.target {\n  min-width: 0;\n  flex: 1;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  color: var(--text-secondary);\n}\n.duration {\n  margin-left: auto;\n  width: 64px;\n  font-size: 12px;\n  color: var(--text-secondary);\n  font-variant-numeric: tabular-nums;\n  text-align: right;\n}\n.chevron[data-open=\"true\"] {\n  transform: rotate(90deg);\n}\n.body {\n  padding: 12px;\n  border-top: 1px solid var(--border);\n}\n.body section {\n  margin-bottom: 16px;\n  min-width: 0;\n}\n.body h4 {\n  font-size: 12px;\n  line-height: 16px;\n  color: var(--text-secondary);\n  font-weight: 500;\n  margin-bottom: 8px;\n}\n.body pre {\n  max-height: 320px;\n  padding: 12px;\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  overflow: auto;\n  background: var(--background);\n  font: 12px/20px monospace;\n}\n.sectionHeader {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 8px;\n}\n.sectionHeader h4 {\n  margin: 0;\n}\n.notice,\n.stage,\n.feedback,\n.error,\n.permission p {\n  font-size: 12px;\n  line-height: 20px;\n  overflow-wrap: anywhere;\n}\n.notice {\n  color: var(--text-secondary);\n  padding: 8px 0;\n}\n.warning {\n  color: var(--warning);\n  font-size: 12px;\n}\n.stage {\n  color: var(--text-secondary);\n  margin-bottom: 12px;\n}\n.error {\n  color: var(--destructive);\n  margin-block: 8px;\n}\n.permission {\n  padding: 12px;\n  border: 1px solid var(--border);\n  border-radius: 6px;\n}\n.actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 8px;\n}\n.actions:empty,\n.feedback:empty {\n  display: none;\n}\n.feedback {\n  margin-top: 8px;\n  color: var(--text-secondary);\n}\n@media (pointer: coarse) {\n  .header {\n    min-height: 44px;\n  }\n}\n",
