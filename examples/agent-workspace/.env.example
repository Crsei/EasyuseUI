# Explicit optional public docs link. Set at build time for the deployment.
# NEXT_PUBLIC_DOCS_ORIGIN=https://your-docs-host.example
# Local development: NEXT_PUBLIC_DOCS_ORIGIN=http://localhost:3010
# Pi endpoint and credential are entered in /pi/ and stored only in this origin's sessionStorage.
# Never put Pi credentials in NEXT_PUBLIC_* variables or URLs.
